{
  "expo": {
    "name": "Kyra",
    "slug": "kalorieLog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.kyra.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.kyra.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Kyra",
      "shortName": "Kyra",
      "description": "Your personal health companion",
      "themeColor": "#007AFF",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kyra to access your camera to take photos of your meals."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3dddd94f-00b8-41b8-b0ea-c61b4285bcd0"
      }
    },
    "owner": "adityadubey29"
  }
}
